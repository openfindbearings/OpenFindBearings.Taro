# 改动说明：pnpm 严格布局把非直接依赖收进 .pnpm 目录、不在顶层 node_modules 建链接，
# 导致 gradle 打包 JS 时 metro/babel 从项目根按名 require 传递依赖
# （metro-config、babel-plugin-transform-react-jsx-to-rn-stylesheet 等）报 Cannot find module。
# shamefully-hoist=true 让 pnpm 把依赖提升到顶层（类 npm 布局），一次性根治这类问题，
# 是 pnpm + React Native 的主流推荐做法。仅影响 node_modules 布局，不改 lockfile 解析、
# 不影响 --frozen-lockfile 校验，也不影响 H5/webpack 构建。
shamefully-hoist=true
